# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Stripe & Mercado Pago (agora configurado por servidor via /config payment-set)
# Essas variáveis não são mais necessárias, mas podem ser usadas como fallback
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token

# Webhook Server
WEBHOOK_PORT=3000
WEBHOOK_URL=https://your-domain.com/webhooks

# Bot Configuration
BOT_ENVIRONMENT=development
LOG_CHANNEL_ID=optional_log_channel_id

# Dashboard (opcional)
DASHBOARD_URL=http://localhost:3001
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3001
