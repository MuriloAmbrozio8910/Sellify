{
  "name": "discord-sales-bot",
  "version": "1.0.0",
  "description": "Sistema completo de vendas Discord com múltiplas funcionalidades",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "ts-node src/deploy-commands.ts",
    "webhook": "ts-node src/webhooks/server.ts",
    "test:purchase": "ts-node scripts/test-purchase.ts",
    "test:env": "ts-node scripts/check-env.ts",
    "cleanup": "ts-node scripts/cleanup-db.ts"
  },
  "keywords": ["discord", "bot", "sales", "payments", "typescript"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "@supabase/supabase-js": "^2.39.3",
    "stripe": "^14.14.0",
    "mercadopago": "^2.0.9",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "axios": "^1.6.5",
    "date-fns": "^3.2.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.3",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/express": "^4.17.21",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
